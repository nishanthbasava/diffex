# Copy to .env and fill in. All values are exposed to the browser (VITE_ prefix) —
# the Supabase key must be the publishable/anon key, never the service role key.

# Passcode for the app gate (PasscodeGate.tsx)
VITE_APP_PASSCODE=

# Supabase project (optional — app falls back to localStorage-only mode if unset)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
